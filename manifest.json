{
  "manifest_version": 3,
  "name": "Prime Video + YouTube Ad Skipper",
  "version": "2.0.0",
  "description": "Locally skips or accelerates ads on Prime Video and YouTube. No telemetry, analytics, storage, or remote requests.",
  "content_scripts": [
    {
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.com/video/*",
        "*://*.amazon.co.uk/gp/video/*",
        "*://*.amazon.de/gp/video/*",
        "*://*.amazon.co.jp/gp/video/*"
      ],
      "js": ["amazon.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_start"
    }
  ]
}
